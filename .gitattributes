# Normalise line endings in the working tree so a Windows checkout does not
# produce a diff on every file, and so hex comparisons in tests do not see \r\n.
* text=auto eol=lf

# Anything a human reads or that a test compares byte for byte.
*.md    text eol=lf
*.hpp   text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.c     text eol=lf
*.cmake text eol=lf
CMakeLists.txt    text eol=lf
CMakePresets.json text eol=lf
.gitignore        text eol=lf
.gitattributes    text eol=lf
.editorconfig     text eol=lf
*.json            text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
LICENSE           text eol=lf

# Never touch line endings or mangle these.
*.svg   text eol=lf
*.png   binary
*.jpg   binary
*.ico   binary